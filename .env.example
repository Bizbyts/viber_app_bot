# Copy this file to .env and fill in real values.

# Required: get this from the Viber Admin Panel after creating a Public Account/bot
# https://partners.viber.com/
VIBER_AUTH_TOKEN=your-viber-auth-token-here

# Bot identity shown to users
BOT_NAME=AppInfoBot
BOT_AVATAR=https://i.imgur.com/9vlBxdt.png

# Must be a PUBLIC, HTTPS URL that reaches this server's /webhook route.
# e.g. https://your-domain.com/webhook or an ngrok URL while testing locally.
WEBHOOK_URL=

# Server
HOST=0.0.0.0
PORT=5000
DEBUG=False

# Behaviour
REQUEST_TIMEOUT=10
DEFAULT_COUNTRY=us
DEFAULT_LANG=en
SEARCH_RESULTS_LIMIT=5
CACHE_TTL_SECONDS=600

# Logging
LOG_LEVEL=INFO
LOG_FILE=
